# Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gold_bot_db

# Optional direct connection URL override
# DATABASE_URL=postgresql://postgres:password@db:5432/gold_bot_db

# Security & CORS
SECRET_KEY=replace-with-strong-random-secret-key
CORS_ORIGINS=*
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business & Bot Contact Defaults (Optional; DB Settings override these)
DEFAULT_GROUP_NAME=Telegram Bot
BOT_USERNAME=
SALES_TELEGRAM_USERNAME=
SALES_PHONE_NUMBER=
SALES_PHONE_DISPLAY=
DEFAULT_SPOT_PRICE=0
DEFAULT_PREMIUM=0

# Bootstrap Super Admin (Required only when running seed scripts or bootstrapping empty users table)
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Ports Configuration (Optional)
API_PORT=8000
FRONTEND_PORT=8080
