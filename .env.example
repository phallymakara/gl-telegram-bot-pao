# Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gold_bot_db

# Optional: Direct Database Connection URL (Overrides POSTGRES_* settings if specified)
# DATABASE_URL=postgresql://postgres:password@db:5432/gold_bot_db

# Security & CORS
SECRET_KEY=change-this-secret-key-12345
CORS_ORIGINS=*

# Frontend Nginx Proxy Target (defaults to http://api:8000)
BACKEND_URL=http://api:8000

# Host Port Mappings (Optional)
API_PORT=8000
FRONTEND_PORT=8080
